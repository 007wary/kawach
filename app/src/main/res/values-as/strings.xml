    <string name="generic_high_title">এইটো প্ৰতাৰণা যেন লাগিছে</string>
    <string name="generic_high_advice">ইয়াত কেইবাটাও সতৰ্কতাৰ চিন আছে। পইচা নিদিব, OTP বা PIN কাকো নিদিব, লিংক নুখুলিব। প্ৰথমে পৰিয়ালক সোধক।</string>
    <string name="generic_medium_title">কিছুমান সতৰ্কতাৰ চিন</string>
    <string name="generic_medium_advice">এতিয়াই একো নকৰিব। পৰিয়ালক সোধক, বা কোম্পানীৰ আনুষ্ঠানিক নম্বৰত ফোন কৰক।</string>
    <string name="low_title">কোনো চিনাকি প্ৰতাৰণা নাই</string>
    <string name="low_advice">Kawach-এ ইয়াত কোনো চিনাকি প্ৰতাৰণা বিচাৰি নাপালে, কিন্তু ই সুৰক্ষিত বুলি নিশ্চিত নহয়। যদি পইচা, OTP বা PIN বিচাৰে, প্ৰথমে পৰিয়ালক সোধক।</string>

    <string name="help_title">পইচা দিলে বা OTP দিলে?</string>
    <string name="help_golden">এতিয়াই কাম কৰক। প্ৰথম এঘণ্টাৰ ভিতৰত অভিযোগ কৰিলে বেংকে পইচা ৰখাৰ সম্ভাৱনা বেছি।</string>
    <string name="help_call_label">চাইবাৰ প্ৰতাৰণা হেল্পলাইন (বিনামূলীয়া, ২৪ ঘণ্টা)</string>
    <string name="help_call">1930ত ফোন কৰক</string>
    <string name="help_step_1">1930ত ফোন কৰি লেনদেন বা UPI ৰেফাৰেন্স নম্বৰ দিয়ক।</string>
    <string name="help_step_2">আপোনাৰ কাৰ্ডৰ পিছফালে থকা নম্বৰত বেংকক ফোন কৰি কাৰ্ড ব্লক কৰক।</string>
    <string name="help_step_3">cybercrime.gov.in-ত প্ৰতাৰণাৰ অভিযোগ দিয়ক।</string>
    <string name="help_step_4">কি হ\'ল পৰিয়ালক জনাওক।</string>
    <string name="help_step_5">পইচা ঘূৰাই আনি দিম বুলি কোৱা কাকো পইচা নিদিব। সেয়া দ্বিতীয় প্ৰতাৰণা।</string>
    <string name="help_portal">cybercrime.gov.in খোলক</string>
    <string name="help_112">এতিয়াই বিপদত? 112ত ফোন কৰক।</string>

