    <string name="scam_digital_arrest_title">ডিজিটেল এৰেষ্ট প্ৰতাৰণা</string>
    <string name="scam_digital_arrest_advice">আৰক্ষী, CBI বা কাষ্টমছে কেতিয়াও ভিডিঅ\' কলত কাকো গ্ৰেপ্তাৰ নকৰে আৰু গোচৰ বন্ধ কৰিবলৈ পইচা নিবিচাৰে। কলটো কাটি নম্বৰটো ব্লক কৰক।</string>
    <string name="scam_bank_kyc_title">ভুৱা বেংক বা KYC বাৰ্তা</string>
    <string name="scam_bank_kyc_advice">বেংকে কেতিয়াও OTP, PIN বা পাছৱৰ্ড নিবিচাৰে, আৰু SMS-ৰে একাউণ্ট ব্লক নকৰে। কাৰ্ডৰ পিছফালে থকা নম্বৰত ফোন কৰক।</string>
    <string name="scam_upi_collect_title">UPI পইচাৰ ফান্দ</string>
    <string name="scam_upi_collect_advice">পইচা পাবলৈ কেতিয়াও UPI PIN দিব নালাগে। PIN দিলে পইচা ওলাই যায়। অনুৰোধটো নাকচ কৰক।</string>
    <string name="scam_investment_title">ভুৱা বিনিয়োগ বা ট্ৰেডিং আঁচনি</string>
    <string name="scam_investment_advice">কোনেও দৈনিক উচ্চ লাভৰ নিশ্চয়তা দিব নোৱাৰে। এনে গোটে পইচা লৈ নোহোৱা হয়। যোগদান কৰিবলৈ পইচা নিদিব।</string>
    <string name="scam_task_job_title">ভুৱা পাৰ্ট-টাইম চাকৰি</string>
    <string name="scam_task_job_advice">সঁচা চাকৰিয়ে ভিডিঅ\' লাইক বা হোটেল ৰেটিঙৰ বাবে পইচা নিদিয়ে, আৰু আগতে পইচা নিবিচাৰে। চেটৰ পৰা ওলাই যাওক।</string>
    <string name="scam_lottery_prize_title">ভুৱা লটাৰী বা পুৰস্কাৰ</string>
    <string name="scam_lottery_prize_advice">আপুনি অংশ লোৱা নাই এনে লটাৰী জিকিব নোৱাৰে। সঁচা পুৰস্কাৰে আগতে মাচুল বা কৰ নিবিচাৰে।</string>
    <string name="scam_electricity_bill_title">ভুৱা বিদ্যুৎ সংযোগ বিচ্ছিন্নৰ বাৰ্তা</string>
    <string name="scam_electricity_bill_advice">বিদ্যুৎ বিভাগে আজি নিশা বিষয়াক ফোন কৰিবলৈ কৈ SMS নপঠিয়ায়। APDCL-ৰ আনুষ্ঠানিক এপ বা ৱেবছাইটত বিল চাওক।</string>
    <string name="scam_family_emergency_title">ভুৱা পাৰিবাৰিক জৰুৰী অৱস্থা</string>
    <string name="scam_family_emergency_advice">প্ৰতাৰকে বিপদত পৰা আত্মীয়ৰ ভাও ধৰে, কেতিয়াবা নকল মাতেৰে। পইচা দিয়াৰ আগতে সেই ব্যক্তিজনক পুৰণি নম্বৰত ফোন কৰক।</string>
    <string name="scam_sextortion_title">ভিডিঅ\' ভাবুকি (ব্লেকমেইল) প্ৰতাৰণা</string>
    <string name="scam_sextortion_advice">পইচা নিদিব। পইচা দিলে দাবী বাঢ়ে। নম্বৰটো ব্লক কৰক, স্ক্ৰীণশ্বট ৰাখক আৰু cybercrime.gov.in-ত অভিযোগ দিয়ক। আপোনাৰ কোনো দোষ নাই।</string>
    <string name="scam_fake_delivery_title">ভুৱা পাৰ্চেল বা ডেলিভাৰী বাৰ্তা</string>
    <string name="scam_fake_delivery_advice">কুৰিয়াৰ কোম্পানীয়ে SMS লিংকৰ জৰিয়তে পইচা বা এপ ইনষ্টল নিবিচাৰে। কেৱল আনুষ্ঠানিক ৱেবছাইটত ট্ৰেক কৰক।</string>

